# --- Required Secrets - ضعها في خانة Secrets الآمنة ---
DATABASE_URL=postgresql://neondb_owner:xxx@ep-xxx.aws.neon.tech/neondb?sslmode=require
RESEND_API_KEY=re_xxx

# --- Clerk Auth 
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx

# --- App ---
NODE_ENV=development
PORT=5000

# --- INSTRUCTIONS FOR AGENT ---
# يا Agent: اذا أي واحد من الأسرار اللي فوق مش موجود في Replit Secrets
# اطلب من المستخدم مباشرة: "حطلي SECRET_NAME في خانة Secrets الآمنة"
# لا تحاول تخمن، ولا تشرح كثير، اسأل مباشر: "حطلي DATABASE_URL"
# التطبيق يشتغل على: pnpm workspaces, Node 24, Drizzle + Neon + Express + Expo
